// MUSK RADAR — Cloudflare Worker 設定
// デプロイ: npx wrangler deploy
// カスタムドメイン: musk.toriumis.com（Workers Custom Domain）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musk-radar",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    { "binding": "NEWS_KV", "id": "3b0b29a9714f40839567b0400b8ad4a4" }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
